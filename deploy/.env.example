# Скопируйте в .env и заполните. setup.sh делает это сам и генерирует пароли.

# Адрес, по которому открывается сервер (без слеша в конце)
PUBLIC_URL=https://subly.antonshkel.ru

# Ключ подписи токенов — длинная случайная строка: openssl rand -hex 32
JWT_SECRET=

# Пароль базы PostgreSQL (контейнер db создаст пользователя с этим паролем)
DATABASE_PASSWORD=

# Почты администраторов через запятую — у них откроется /admin
ADMIN_EMAILS=

# ЮKassa: Настройки → Магазин → shopId и секретный ключ.
# Для теста возьмите ключи тестового магазина — деньги не списываются.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
