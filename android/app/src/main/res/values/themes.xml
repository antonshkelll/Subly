<resources>
    <!-- Фон окна совпадает с фоном приложения: при запуске нет белой вспышки. -->
    <style name="Theme.Subly" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="window">#F2F2F7</color>
</resources>
